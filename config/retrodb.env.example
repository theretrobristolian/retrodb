# ==============================================================================
# RetroDB configuration example
# ==============================================================================
#
# The live configuration is stored at:
#   /etc/retrodb/retrodb.env
#
# Never commit the live file or real credentials to Git.
#
# Application
RETRODB_ENV=production

# PostgreSQL
# Generated automatically by server/deploy.sh.
RETRODB_DATABASE_URL=postgresql+psycopg://retrodb:generated-secret@/retrodb?host=/var/run/postgresql

# RetroAchievements Web API
# Setup guide:
# https://github.com/theretrobristolian/retrodb/blob/main/docs/retroachievements-setup.md
#
# Obtain the Web API key from the Keys section of your RetroAchievements
# control panel. This is not your account password or Connect API token.
RETRODB_RA_USERNAME=
RETRODB_RA_API_KEY=
